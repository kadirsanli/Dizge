{
  "name": "@kadirsanli/dizge",
  "version": "0.3.0",
  "description": "Türkçe kaynaklı, tek dosyalık HTML uygulamaları için UI, veri analizi, PDF ve XLSX araç kutusu",
  "main": "dizge.js",
  "module": "dizge.mjs",
  "types": "dizge.d.ts",
  "exports": {
    ".": {
      "types": "./dizge.d.ts",
      "import": "./dizge.mjs",
      "require": "./dizge.js"
    },
    "./worker": "./dizge.worker.js",
    "./vitrin": "./scripts/vitrin.cjs",
    "./dizge.js": "./dizge.js",
    "./dizge-html.js": "./dizge-html.js",
    "./dizge-html.min.js": "./dizge-html.min.js"
  },
  "bin": {
    "dizge-vitrin": "scripts/vitrin.cjs"
  },
  "files": [
    "dizge.js",
    "dizge.min.js",
    "dizge.mjs",
    "dizge.d.ts",
    "dizge.worker.js",
    "dizge-html.js",
    "dizge-html.min.js",
    "docs/turkce-html.md",
    "docs/TURKCE-HTML-YOL-HARITASI.md",
    "examples/turkce-html.html",
    "docs/javascript.md",
    "docs/javascript-tr.md",
    "docs/javascript-ai.md",
    "examples/tek-dosya.html",
    "examples/tek-dosya-uygulama.html",
    "scripts/vitrin.cjs",
    "templates/vitrin.html",
    "LICENSE-JS"
  ],
  "keywords": [
    "türkçe",
    "html",
    "ui",
    "veri",
    "csv",
    "xlsx",
    "pdf",
    "vitrin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "build:tek": "node scripts/tek-dosya.cjs",
    "check:tek": "node scripts/tek-dosya.cjs --check",
    "check": "tsc --noEmit --strict --lib ES2022,DOM tests/types.ts",
    "bench": "node scripts/bench.cjs",
    "test:browser": "node scripts/tek-dosya.cjs && node scripts/browser-test.cjs",
    "test:html": "node scripts/html-browser-test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadirsanli/Dizge.git"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
