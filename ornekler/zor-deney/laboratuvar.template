</script><script>
'use strict';
(()=>{const $=id=>document.getElementById(id),canvas=$('view'),ctx=canvas.getContext('2d'),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));let config=K.defaults,ast,simulation,mesh=null,playing=false,testing=false,job=0,frames=[],previous=0,lastLabels=0,buildMs=0,stepCount=0,initialEnergy=0,trails=[],result=null,generation=false;
function notify(text,error=false){$('status').textContent=text;$('status').classList.toggle('error',error)}
function setMetric(k,value,label){$('m'+k).textContent=value;$('l'+k).textContent=label}
function syncControls(){for(const key of['formula','grid','bodies','dt','seed','qgrid','potential','qdt'])$(key).value=config[key];for(const lab of['newton','gravity','quantum'])$(lab+'Controls').hidden=config.lab!==lab;for(const b of document.querySelectorAll('[data-lab]'))b.setAttribute('aria-selected',String(config.lab===b.dataset.lab));$('step').disabled=config.lab==='newton'||generation||testing;$('play').textContent=playing?'Duraklat':config.lab==='newton'?'Kamerayı oynat':'Oynat';$('play').setAttribute('aria-pressed',String(playing));$('equation').textContent=config.lab==='newton'?'f(z) = '+config.formula:config.lab==='gravity'?'N-cisim / Hamiltonyen akış':'i∂ψ/∂t = (−½∇² + V)ψ';$('subheading').textContent=config.lab==='newton'?'Yükseklik: iterasyon sayısı · Renk: bulunan kökün fazı':config.lab==='gravity'?'Velocity-Verlet · yumuşatılmış Newton çekimi':'2B FFT · simetrik split-operator · periyodik kutu';$('description').textContent=config.lab==='newton'?'Her nokta bir Newton başlangıcı. Üç boyutlu yükseltiler, köke ulaşmak için gereken adım sayısını gösterir. Kırmızımsı koyu bölgeler yakınsamayan veya tanımsız başlangıçlardır.':config.lab==='gravity'?'Üç boyutlu parçacık yörüngeleri. Kütlelerin karşılıklı kuvvetleri eşzamanlı hesaplanır; momentum ve enerji hatası ölçülür.':'Dalgayı oynatarak kırınımı ve yayılmayı inceleyin. 3B örgü gerçek olasılık yoğunluğundan üretilir; sıfıra yakın genlikte faz güvenilir bir görsel nicelik değildir.'}
function makeMesh(n,sampler){const points=[],faces=[];for(let j=0;j<=n;j++)for(let i=0;i<=n;i++){const v=sampler(i,j);points.push({x:4*i/n-2,y:v.h-.9,z:4*j/n-2,color:v.color})}for(let j=0;j<n;j++)for(let i=0;i<n;i++){const a=j*(n+1)+i;for(const ids of[[a,a+n+1,a+1],[a+1,a+n+1,a+n+2]]){const p=points[ids[0]],q=points[ids[1]],r=points[ids[2]],dx=(q.y-p.y)+(r.y-p.y),light=clamp(56-dx*30,28,67);faces.push({ids,color:`hsl(${p.color.h} ${p.color.s}% ${light}%)`})}}return{points,faces}}
async function generate(){const token=++job;playing=false;generation=true;syncControls();mesh=null;const start=performance.now();try{ast=K.compile(config.formula);const n=config.grid,values=new Array((n+1)**2),statuses={root:0,critical:0,singular:0,branch:0,limit:0,escape:0};for(let j=0;j<=n;j++){if(token!==job)return;for(let i=0;i<=n;i++){const r=K.solve(ast,[4*i/n-2,4*j/n-2],FLOW.newton,32);statuses[r.status]=(statuses[r.status]||0)+1;values[j*(n+1)+i]=r}if(j%4===0){notify(`Newton örgüsü: %${Math.round(100*j/n)} · yeni üretim öncekini iptal eder`);await new Promise(requestAnimationFrame)}}if(token!==job)return;mesh=makeMesh(n,(i,j)=>{const r=values[j*(n+1)+i],phase=Math.atan2(r.z[1],r.z[0]);return{h:r.status==='root'?Math.min(3.2,r.iteration*.105):3.3,color:{h:r.status==='root'?(phase*180/Math.PI+360)%360:5,s:r.status==='root'?75:20}}});mesh.statuses=statuses;mesh.vertices=values.length;buildMs=performance.now()-start;notify(`Örgü hazır · ${statuses.root}/${values.length} kök · ${Object.entries(statuses).filter(([k,v])=>k!=='root'&&v).map(([k,v])=>k+': '+v).join(' · ')||'tüm noktalar yakınsadı'}`);probe()}catch(e){notify(e.message,true)}finally{if(token===job){generation=false;syncControls()}}}
function waveMesh(){const n=Math.min(48,simulation.n);mesh=makeMesh(n,(i,j)=>{const x=Math.floor(i*simulation.n/n)%simulation.n,y=Math.floor(j*simulation.n/n)%simulation.n,k=y*simulation.n+x,d=simulation.re[k]**2+simulation.im[k]**2;return{h:Math.min(4,6*d),color:{h:(Math.atan2(simulation.im[k],simulation.re[k])*180/Math.PI+360)%360,s:d<1e-7?15:80}}})}
async function restart(){job++;playing=false;stepCount=0;trails=[];syncControls();if(config.lab==='newton'){await generate();return}generation=false;const t=performance.now();if(config.lab==='gravity'){simulation=K.bodies(config.bodies,config.seed,config.dt);initialEnergy=K.gravityStats(simulation).energy;mesh=null}else{simulation=K.wave(config.qgrid,config.potential,config.qdt);waveMesh()}buildMs=performance.now()-t;notify('Deney hazır; Oynat veya Tek adım ile ilerletin.');$('pointResult').textContent=config.lab==='gravity'?'Yumuşatılmış çekim\nG=1, ε=0.03\nAynı tohum → aynı başlangıç.':'Kutu: 12×12\nħ=m=1\nBaşlangıç normu=1\nHer adımda renormalizasyon yok.';syncControls();labels()}
async function set(patch){const next=K.settings(patch,config),changed=['lab','formula','grid','bodies','dt','seed','qgrid','potential','qdt'].some(k=>next[k]!==config[k]);config=next;syncControls();if(changed)await restart();return{...config}}
function probe(){if(config.lab!=='newton')return;const x=$('x').value.trim(),y=$('y').value.trim();if(x===''||y===''){ $('pointResult').textContent='x ve y gerekli.';return}try{const r=K.solve(ast,[Number(x),Number(y)],FLOW.newton,64);$('pointResult').textContent=`Durum: ${r.status}\nz = ${r.z[0].toPrecision(7)} ${r.z[1]<0?'−':'+'} ${Math.abs(r.z[1]).toPrecision(7)}i\nİterasyon: ${r.iteration}\nArtık: ${Number.isFinite(r.residual)?r.residual.toExponential(3):'tanımsız'}${r.error?'\n'+r.error:''}`}catch(e){$('pointResult').textContent=e.message}}
function step(){if(testing||generation)return;if(config.lab==='gravity'){simulation=FLOW.gravity(simulation);trails.push(simulation.p.slice());if(trails.length>80)trails.shift()}else if(config.lab==='quantum'){simulation=FLOW.quantum(simulation);waveMesh()}stepCount++}
function project(p,w,h){const a=Math.cos(config.yaw),b=Math.sin(config.yaw),c=Math.cos(config.pitch),s=Math.sin(config.pitch),x=a*p.x+b*p.z,z=-b*p.x+a*p.z,y=c*p.y-s*z,Z=s*p.y+c*z,depth=config.zoom-Z;if(depth<.2)return null;const scale=Math.min(w,h)*.88/depth;return{x:w/2+x*scale,y:h*.56-y*scale,depth,scale}}
function draw(t){requestAnimationFrame(draw);if(document.hidden){previous=0;return}if(previous){frames.push(t-previous);if(frames.length>60)frames.shift()}previous=t;if(playing&&!testing&&!generation){if(config.lab==='newton')config=Object.freeze({...config,yaw:config.yaw+.003});else step()}const dpr=Math.min(devicePixelRatio||1,1.5),w=canvas.clientWidth,h=canvas.clientHeight;if(canvas.width!==Math.round(w*dpr)||canvas.height!==Math.round(h*dpr)){canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr)}ctx.setTransform(dpr,0,0,dpr,0,0);ctx.fillStyle='#101923';ctx.fillRect(0,0,w,h);ctx.strokeStyle='#2b3c4d';ctx.lineWidth=1;for(let k=-2;k<=2;k+=.5)for(const[one,two]of[[{x:-2,y:-.94,z:k},{x:2,y:-.94,z:k}],[{x:k,y:-.94,z:-2},{x:k,y:-.94,z:2}]]){const a=project(one,w,h),b=project(two,w,h);if(a&&b){ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke()}}
if(mesh){const projected=mesh.points.map(p=>project(p,w,h));const sorted=mesh.faces.map(f=>({f,depth:f.ids.reduce((sum,i)=>sum+(projected[i]?.depth||0),0)})).sort((a,b)=>b.depth-a.depth);for(const{f}of sorted){const[a,b,c]=f.ids.map(i=>projected[i]);if(!a||!b||!c)continue;ctx.fillStyle=f.color;ctx.strokeStyle=f.color;ctx.lineWidth=.45;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(c.x,c.y);ctx.closePath();ctx.fill();ctx.stroke()}}
if(config.lab==='gravity'&&simulation){const point=(p,k)=>project({x:p[k*3]*.9,y:p[k*3+1]*.9,z:p[k*3+2]*.9},w,h);for(let k=0;k<simulation.n;k++){ctx.strokeStyle=`hsla(${k*137.5%360} 75% 66% / .28)`;ctx.lineWidth=1;ctx.beginPath();let valid=false;for(const p of trails){const q=point(p,k);if(q){if(!valid)ctx.moveTo(q.x,q.y);else ctx.lineTo(q.x,q.y);valid=true}}ctx.stroke()}const points=Array.from({length:simulation.n},(_,k)=>({k,p:point(simulation.p,k)})).filter(x=>x.p).sort((a,b)=>b.p.depth-a.p.depth);for(const{k,p}of points){ctx.fillStyle=`hsl(${k*137.5%360} 85% 70%)`;ctx.beginPath();ctx.arc(p.x,p.y,clamp(7*7/p.depth,2,13),0,Math.PI*2);ctx.fill()}}
if(t-lastLabels>400){labels();lastLabels=t}}
function labels(){const fps=frames.length?1000*frames.length/frames.reduce((a,b)=>a+b,0):0;if(config.lab==='newton'){setMetric(1,mesh?.vertices||'—','Newton başlangıcı');setMetric(2,mesh?.statuses?.root||0,'Köke yakınsayan');setMetric(3,buildMs.toFixed(1),'Üretim + UI bekleme · ms')}else if(config.lab==='gravity'&&simulation){const stats=K.gravityStats(simulation);setMetric(1,stepCount,'Sayısal adım');setMetric(2,Math.abs((stats.energy-initialEnergy)/initialEnergy).toExponential(2),'Bağıl enerji hatası');setMetric(3,Math.hypot(...stats.momentum).toExponential(2),'Toplam momentum normu');$('pointResult').textContent=`t = ${simulation.t.toFixed(4)}\nE = ${stats.energy.toPrecision(9)}\nΔt = ${config.dt}\nCisim: ${config.bodies}`}else if(simulation){const stats=K.waveStats(simulation);setMetric(1,simulation.t.toFixed(3),'Fiziksel zaman');setMetric(2,stats.norm.toFixed(10),'∫ |ψ|² dxdy');setMetric(3,Math.abs(stats.norm-1).toExponential(2),'Norm hatası');$('pointResult').textContent=`Adım: ${stepCount}\nIzgara: ${simulation.n} × ${simulation.n}\nmax |ψ|² = ${stats.max.toPrecision(5)}\nPeriyodik sınır`;}setMetric(4,fps.toFixed(0),'FPS · çizim dahil')}
function exportSettings(){return{app:'zor-deney',version:1,settings:{...config}}}
async function importSettings(text){const d=JSON.parse(text);if(!d||d.app!=='zor-deney'||d.version!==1)throw Error('Desteklenmeyen JSON biçimi/sürümü.');const checked=K.settings(d.settings,config,true);return set(checked)}
function save(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),2000)}
async function audit(){if(testing)throw Error('Test zaten çalışıyor.');testing=true;playing=false;syncControls();$('audit').disabled=true;try{result=await runChecks(FLOW,REFERENCE,{progress:s=>notify('Test: '+s),yieldUI:()=>new Promise(requestAnimationFrame)});$('testOutput').textContent=JSON.stringify(result,null,2);$('auditSave').disabled=false;notify(`${result.passed}/${result.total} kontrol geçti · İmkânsız çözüm: 0/3, doğru ret: 3/3`);return result}catch(e){notify('Test hatası: '+e.message,true);throw e}finally{testing=false;$('audit').disabled=false;syncControls()}}
async function ceiling(){if(testing)throw Error("Test zaten çalışıyor.");testing=true;playing=false;syncControls();try{const value=await runCeiling(FLOW,s=>notify(s),()=>new Promise(requestAnimationFrame));result=value;$("auditSave").disabled=false;$("testOutput").textContent=JSON.stringify(value,null,2);notify("60 FPS tavan: "+value.passed+"/3 geçti. Bu, ana kalite puanından ayrı bir gecikme hedefidir.");return value}finally{testing=false;syncControls()}}
window.lab={ceiling,set,exportSettings,importSettings,audit,stats:()=>({method:METHOD,config:{...config},stepCount,buildMs,mesh:mesh?{vertices:mesh.points.length,triangles:mesh.faces.length,statuses:mesh.statuses}:null,simulation:config.lab==='gravity'&&simulation?K.gravityStats(simulation):config.lab==='quantum'&&simulation?K.waveStats(simulation):null}),impossible:K.impossible};
for(const button of document.querySelectorAll('[data-lab]'))button.onclick=()=>set({lab:button.dataset.lab}).catch(e=>notify(e.message,true));$('parameters').onsubmit=async e=>{e.preventDefault();const patch=config.lab==='newton'?{formula:$('formula').value,grid:Number($('grid').value)}:config.lab==='gravity'?{bodies:Number($('bodies').value),dt:Number($('dt').value),seed:Number($('seed').value)}:{qgrid:Number($('qgrid').value),potential:$('potential').value,qdt:Number($('qdt').value)};try{const before=config;await set(patch);if(config===before)probe();else if(config.lab==='newton')probe()}catch(e){notify(e.message,true)}};
$('play').onclick=()=>{playing=!playing;syncControls()};$('step').onclick=()=>{step();labels()};$('reset').onclick=()=>restart();const camera=()=>set({yaw:K.defaults.yaw,pitch:K.defaults.pitch,zoom:K.defaults.zoom});$('camera').onclick=camera;$('near').onclick=()=>set({zoom:clamp(config.zoom-.5,4,16)});$('far').onclick=()=>set({zoom:clamp(config.zoom+.5,4,16)});
let drag=null;canvas.onpointerdown=e=>{drag={id:e.pointerId,x:e.clientX,y:e.clientY};canvas.setPointerCapture(e.pointerId);canvas.focus()};canvas.onpointermove=e=>{if(!drag||drag.id!==e.pointerId)return;set({yaw:config.yaw+(e.clientX-drag.x)*.007,pitch:clamp(config.pitch+(e.clientY-drag.y)*.007,-.1,1.4)});drag.x=e.clientX;drag.y=e.clientY};canvas.onpointerup=canvas.onpointercancel=canvas.onlostpointercapture=()=>drag=null;canvas.addEventListener('wheel',e=>{e.preventDefault();set({zoom:clamp(config.zoom+e.deltaY*.006,4,16)})},{passive:false});canvas.onkeydown=e=>{const k=e.key;if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','+','=','-','r','R',' '].includes(k))return;e.preventDefault();if(k==='r'||k==='R')camera();else if(k===' ')$('play').click();else if(k==='ArrowLeft'||k==='ArrowRight')set({yaw:config.yaw+(k==='ArrowLeft'?-.1:.1)});else if(k==='ArrowUp'||k==='ArrowDown')set({pitch:clamp(config.pitch+(k==='ArrowUp'?-.1:.1),-.1,1.4)});else set({zoom:clamp(config.zoom+(k==='-'?.5:-.5),4,16)})};
$('jsonSave').onclick=()=>save(new Blob([JSON.stringify(exportSettings(),null,2)],{type:'application/json'}),METHOD+'-ayarlar.json');$('jsonOpen').onclick=()=>$('file').click();$('file').onchange=async()=>{try{const f=$('file').files[0];if(!f)return;if(f.size>50000)throw Error('Dosya 50 KB sınırını aşıyor.');await importSettings(await f.text());notify('Ayarlar yüklendi.')}catch(e){notify('JSON: '+e.message,true)}finally{$('file').value=''}};$('png').onclick=()=>canvas.toBlob(blob=>{if(blob)save(blob,METHOD+'-'+config.lab+'.png');else notify('PNG üretilemedi.',true)},'image/png');$('audit').onclick=()=>audit().catch(()=>{});$('auditSave').onclick=()=>{if(result)save(new Blob([JSON.stringify(result,null,2)],{type:'application/json'}),METHOD+'-test.json')};for(const b of document.querySelectorAll('[data-limit]'))b.onclick=()=>{$('limitResult').textContent=JSON.stringify(K.impossible(b.dataset.limit),null,2)};
$('methodSource').textContent=/*__SOURCE_STRING__*/;$("ceiling").onclick=()=>ceiling().catch(e=>notify(e.message,true));restart();requestAnimationFrame(draw);
})();
</script></body></html>
