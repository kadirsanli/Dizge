 for(let j=0;j<width;j++)for(let i=0;i<width;i++){const k=j*width+i,s=sample(model.radius*(2*i/n-1),model.radius*(2*j/n-1));samples[k]=s;good[k]=s.valid?1:0;if(!s.valid){masked++;heights[k]=0}else{clipped+=Number(s.clipped);heights[k]=limit(s.height,-6,6)}}
 for(let j=0;j<width;j++)for(let i=0;i<width;i++){const k=j*width+i,o=k*9,s=samples[k],left=j*width+Math.max(0,i-1),right=j*width+Math.min(n,i+1),top=Math.max(0,j-1)*width+i,bottom=Math.min(n,j+1)*width+i;data[o]=4*i/n-2;data[o+1]=heights[k]*model.scale-.8;data[o+2]=4*j/n-2;data[o+3]=good[left]&&good[right]?-(heights[right]-heights[left])*model.scale*n/8:0;data[o+4]=1;data[o+5]=good[top]&&good[bottom]?-(heights[bottom]-heights[top])*model.scale*n/8:0;data[o+6]=s.phase===null||!s.valid?0:Math.cos(s.phase);data[o+7]=s.phase===null||!s.valid?0:Math.sin(s.phase);data[o+8]=s.phase===null||!s.valid?0:1;}
