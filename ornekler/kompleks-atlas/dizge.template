for(const[id,key]of Object.entries(controls))el(id).addEventListener('input',()=>{try{set({[key]:key==='fn'||key==='mode'?el(id).value:Number(el(id).value)})}catch(e){notify(e.message,true)}});
const home=()=>set({yaw:defaults.yaw,pitch:defaults.pitch,distance:defaults.distance,auto:false});el('home').onclick=home;el('motion').onclick=()=>set({auto:!model.auto});el('near').onclick=()=>set({distance:limit(model.distance-.6,4,18)});el('far').onclick=()=>set({distance:limit(model.distance+.6,4,18)});el('calculator').onsubmit=e=>{e.preventDefault();inspect()};
const canvas=el('surface');let pointer=null;canvas.onpointerdown=e=>{pointer={id:e.pointerId,x:e.clientX,y:e.clientY};canvas.setPointerCapture(e.pointerId);canvas.focus()};canvas.onpointermove=e=>{if(!pointer||e.pointerId!==pointer.id)return;set({yaw:model.yaw+(e.clientX-pointer.x)*.007,pitch:limit(model.pitch+(e.clientY-pointer.y)*.007,-.2,1.4)});pointer.x=e.clientX;pointer.y=e.clientY};canvas.onpointerup=canvas.onpointercancel=canvas.onlostpointercapture=()=>pointer=null;canvas.addEventListener('wheel',e=>{e.preventDefault();set({distance:limit(model.distance+e.deltaY*.008,4,18)})},{passive:false});canvas.onkeydown=e=>{const k=e.key;if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','+','=','-','r','R',' '].includes(k))return;e.preventDefault();if(k==='r'||k==='R')home();else if(k===' ')set({auto:!model.auto});else if(k==='ArrowLeft'||k==='ArrowRight')set({yaw:model.yaw+(k==='ArrowLeft'?-.1:.1)});else if(k==='ArrowUp'||k==='ArrowDown')set({pitch:limit(model.pitch+(k==='ArrowUp'?-.1:.1),-.2,1.4)});else set({distance:limit(model.distance+(k==='-'?.5:-.5),4,18)})};
function save(blob,name){const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=name;link.click();setTimeout(()=>URL.revokeObjectURL(url),3000)}
el('export').onclick=()=>{save(new Blob([JSON.stringify(exportSettings(),null,2)],{type:'application/json'}),'atlas-dizge.json');notify('JSON hazırlandı.')};el('import').onclick=()=>el('upload').click();el('upload').onchange=async()=>{try{const f=el('upload').files[0];if(!f)return;if(f.size>50000)throw Error('JSON 50 KB sınırını aşıyor.');importSettings(await f.text());notify('Ayarlar yüklendi.')}catch(e){notify('JSON yüklenemedi: '+e.message,true)}finally{el('upload').value=''}};el('image').onclick=()=>{renderer.render();canvas.toBlob(blob=>{if(blob){save(blob,'atlas-dizge.png');notify('PNG hazırlandı.')}else notify('PNG oluşturulamadı.',true)},'image/png')};el('verify').onclick=()=>{const t=test();el('verification').textContent=`${t.passed}/${t.total} geçti\n`+t.results.map(r=>(r.pass?'✓ ':'✗ ')+r.name).join('\n')};canvas.addEventListener('webglcontextlost',e=>{e.preventDefault();cancelAnimationFrame(renderer.raf);notify('Grafik bağlamı kayboldu. Sayfayı yeniden yükleyin.',true)});
})();
</script></body></html>
